            const el2 = document.getElementById('stat-total-soal'); if(el2) el2.innerText = total;
            const el3 = document.getElementById('summary-jenjang'); if(el3) el3.innerText = appData.identitas.kelas;
            const el4 = document.getElementById('summary-mapel'); if(el4) el4.innerText = appData.identitas.mapel;

            let l1 = 0, l2 = 0, l3 = 0, pg = 0, uraian = 0;
            appData.soalList.forEach(s => {
                if(s.level === 'L1') l1++;
                if(s.level === 'L2') l2++;
                if(s.level === 'L3') l3++;
                if(s.bentuk === 'Pilihan Ganda') pg++;
                if(s.bentuk === 'Uraian') uraian++;
