        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        kemenag: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                            800: '#065f46',
                            900: '#064e3b',
                            gold: '#d97706'
                        }
                    },
                    fontFamily: {
                        sans: ['Poppins', 'Inter', 'sans-serif']
