        function getGenericBank(mapel, index) {
            const list = sampleBanks[mapel] || sampleBanks["Matematika"];
            if(list && list.length > 0) {
                return list[(index - 1) % list.length];
            }
            return {
                materi: "Materi Pokok Asesmen",
                indikator: `Peserta didik dapat memahami konsep dasar pada nomor ${index} dengan tepat.`,
                level: index % 3 === 0 ? "L3" : (index % 2 === 0 ? "L2" : "L1"),
                bentuk: index === 5 ? "Uraian" : "Pilihan Ganda",
                soal: `Berikut ini manakah pernyataan yang paling tepat berkaitan dengan materi asesmen nomor ${index}?`,
                opsi: { A: "Pilihan jawaban pertama yang logis", B: "Pilihan jawaban kedua yang benar", C: "Pilihan jawaban ketiga sebagai pengecoh", D: "Pilihan jawaban keempat sebagai pengecoh" },
                kunci: "B",
                pembahasan: `Pembahasan untuk soal nomor ${index} telah disesuaikan dengan indikator pencapaian kompetensi.`,
                rubrik: "Skor 4 = sangat lengkap. Skor 0 = salah."
            };
        }

