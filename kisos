        function addKisiRow() {
            const newNo = appData.kisiList.length + 1;
            const generatedNew = getGenericBank(appData.wizard.mapel, newNo);

            appData.kisiList.push({
                no: newNo,
                cp: appData.wizard.cp,
                tp: appData.wizard.tp,
                materi: appData.wizard.materi || "Materi Baru",
                indikator: generatedNew.indikator,
                level: generatedNew.level,
                bentuk: generatedNew.bentuk,
                noSoal: newNo
            });
            appData.soalList.push({
                no: newNo,
                materi: appData.wizard.materi || "Materi Baru",
                indikator: generatedNew.indikator,
                level: generatedNew.level,
                bentuk: generatedNew.bentuk,
                soal: generatedNew.soal,
                opsi: generatedNew.opsi,
                kunci: generatedNew.kunci,
                pembahasan: generatedNew.pembahasan,
                rubrik: generatedNew.rubrik
            });
            renderAllTables();
            showToast("Baris kisi-kisi dan soal sinkron berhasil ditambahkan!");
        }

        function deleteKisi(idx) {
            if(appData.kisiList.length <= 1) {
                showToast("Minimal harus menyisakan 1 soal dalam asesmen!", "error");
                return;
            }
            appData.kisiList.splice(idx, 1);
            appData.soalList.splice(idx, 1);
            appData.kisiList.forEach((k, i) => { k.no = i+1; k.noSoal = i+1; });
            appData.soalList.forEach((s, i) => { s.no = i+1; });
            renderAllTables();
            showToast("Baris berhasil dihapus.");
        }

        function editKisi(idx) {
            const item = appData.kisiList[idx];
            const newIndikator = prompt("Edit Indikator Soal:", item.indikator);
            if(newIndikator !== null) {
                item.indikator = newIndikator;
                appData.soalList[idx].indikator = newIndikator;
                renderAllTables();
                showToast("Indikator berhasil diperbarui dan disinkronkan!");
            }
        }

        function generateSoalFromKisi() {
            showToast("Sinkronisasi Kisi-Kisi dan Soal Selesai (100% Akurat)!");
            switchTab('soal');
        }

        function regenerateSoalItem(idx) {
            showToast(`Meregenerasi Soal Nomor ${idx+1} beserta sinkronisasi opsi...`);
            setTimeout(() => {
                const s = appData.soalList[idx];
                const refreshed = getGenericBank(appData.identitas.mapel, idx + 1);
                s.soal = refreshed.soal;
                s.opsi = refreshed.opsi;
                s.kunci = refreshed.kunci;
                s.pembahasan = refreshed.pembahasan;
                renderSoalList();
                showToast(`Soal Nomor ${idx+1} berhasil diregenerasi dan disinkronkan secara presisi!`);
            }, 500);
        }

        function regenerateAllSoal() {
            showToast("Meregenerasi dan menyinkronkan semua naskah soal & opsi jawaban...");
            setTimeout(() => {
                appData.soalList.forEach((s, idx) => {
                    const refreshed = getGenericBank(appData.identitas.mapel, idx + 1);
                    s.soal = refreshed.soal;
                    s.opsi = refreshed.opsi;
                    s.kunci = refreshed.kunci;
                    s.pembahasan = refreshed.pembahasan;
                });
                renderSoalList();
                showToast("Semua naskah soal dan opsi jawaban berhasil disinkronkan!");
            }, 800);
        }

        function runValidasiAI() {
            showToast("Validasi AI Selesai: 100% Soal & Opsi Jawaban Sinkron!");
