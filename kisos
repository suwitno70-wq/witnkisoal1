                    if(title) title.innerText = "Langkah 1/4: Menganalisis CP & TP...";
                    if(desc) desc.innerText = "Memeriksa kesesuaian Capaian Pembelajaran dengan Kurikulum Merdeka/K13...";
                    if(progress) progress.style.width = "25%";
                } else if(step === 2) {
                    if(title) title.innerText = "Langkah 2/4: Menyusun Indikator Soal...";
                    if(desc) desc.innerText = "Membuat indikator spesifik terukur berbasis Taksonomi Bloom (L1, L2, L3)...";
                    if(progress) progress.style.width = "50%";
                } else if(step === 3) {
                    if(title) title.innerText = "Langkah 3/4: Sinkronisasi Soal & Opsi Jawaban...";
                    if(desc) desc.innerText = "Memastikan opsi A, B, C, D sinkron dan kunci jawaban tepat...";
                    if(progress) progress.style.width = "85%";
                } else if(step === 4) {
                    if(title) title.innerText = "Langkah 4/4: Validasi & Traceability...";
                    if(desc) desc.innerText = "Memverifikasi konsistensi 1 baris kisi-kisi = 1 unit soal...";
                    if(progress) progress.style.width = "100%";
                } else {
                    clearInterval(interval);
                    if(modal) modal.classList.add('hidden');
                    generateDataStructures();
                    switchTab('kisi');
                    showToast("Generator AI Berhasil Menyusun & Mensinkronkan Soal!");
                }
                step++;
            }, 500);
        }

        function generateDataStructures() {
            const total = appData.wizard.jumlahSoal;
            appData.kisiList = [];
            appData.soalList = [];

            const mapelBank = sampleBanks[appData.wizard.mapel] || [];

            for(let i=1; i<=total; i++) {
                let bankItem = null;
                if(mapelBank.length > 0 && (i-1) < mapelBank.length) {
                    bankItem = mapelBank[i-1];
                } else {
                    bankItem = getGenericBank(appData.wizard.mapel, i);
                }

                appData.kisiList.push({
                    no: i,
                    cp: appData.wizard.cp,
                    tp: appData.wizard.tp,
                    materi: bankItem.materi,
                    indikator: bankItem.indikator,
                    level: bankItem.level,
                    bentuk: bankItem.bentuk,
                    noSoal: i
                });

                appData.soalList.push({
                    no: i,
                    materi: bankItem.materi,
                    indikator: bankItem.indikator,
                    level: bankItem.level,
                    bentuk: bankItem.bentuk,
                    soal: bankItem.soal,
                    opsi: bankItem.opsi || { A: "Pilihan A", B: "Pilihan B", C: "Pilihan C", D: "Pilihan D" },
                    kunci: bankItem.kunci || "A",
                    pembahasan: bankItem.pembahasan || "Pembahasan otomatis sesuai kaidah indikator.",
                    rubrik: bankItem.rubrik || "Rubrik penilaian standar."
                });
            }

            renderAllTables();
        }

