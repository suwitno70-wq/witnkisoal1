        .tab-content.active { display: block; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 h-full flex flex-col font-sans antialiased selection:bg-kemenag-500 selection:text-white">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Loading Modal / AI Simulation Overlay -->
    <div id="ai-loading-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center">
        <div class="bg-white rounded-2xl p-8 max-w-md w-full mx-4 shadow-2xl text-center border border-kemenag-100 animate-pulse">
            <div class="w-16 h-16 bg-kemenag-100 text-kemenag-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
                <i class="fa-solid fa-brain fa-spin"></i>
            </div>
            <h3 id="loading-title" class="text-xl font-bold text-slate-900 mb-2">AI Sedang Bekerja...</h3>
            <p id="loading-desc" class="text-sm text-slate-500 mb-6">Mensinkronkan opsi jawaban dan soal agar 100% akurat sesuai indikator...</p>
            <div class="w-full bg-slate-100 rounded-full h-2.5 overflow-hidden">
                <div id="loading-progress" class="bg-kemenag-600 h-2.5 rounded-full transition-all duration-300 w-1/4"></div>
            </div>
        </div>
    </div>

    <!-- Header / Navbar -->
    <header class="bg-gradient-to-r from-kemenag-900 via-kemenag-800 to-kemenag-700 text-white shadow-lg sticky top-0 z-40 no-print">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-amber-400 text-xl font-bold shadow-inner">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight tracking-wide">KISI-SOAL AI <span class="text-amber-400 text-xs px-2 py-0.5 bg-amber-400/20 rounded-full border border-amber-400/30">SD / MI</span></h1>
                    <p class="text-xs text-kemenag-100 opacity-90 hidden sm:block">Generator Kisi-Kisi & Soal Otomatis Berbasis Indikator • Development by witno</p>
                </div>
            </div>
            <div class="flex items-center space-x-2">
                <button onclick="openProjectModal()" class="px-3 py-1.5 bg-white/10 hover:bg-white/20 text-white rounded-lg text-xs font-medium transition flex items-center space-x-1.5 border border-white/10">
                    <i class="fa-solid fa-folder-open text-amber-300"></i>
                    <span class="hidden md:inline">Proyek</span>
                </button>
                <button onclick="resetProject()" class="px-3 py-1.5 bg-red-500/20 hover:bg-red-500/30 text-red-200 rounded-lg text-xs font-medium transition flex items-center space-x-1.5 border border-red-500/30">
                    <i class="fa-solid fa-rotate-right"></i>
                    <span class="hidden md:inline">Reset</span>
                </button>
                <button onclick="switchTab('dashboard')" class="px-3 py-1.5 bg-kemenag-600 hover:bg-kemenag-500 text-white rounded-lg text-xs font-semibold transition flex items-center space-x-1.5 shadow">
                    <i class="fa-solid fa-chart-pie"></i>
                    <span>Dashboard</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full flex flex-col">
        
        <!-- Navigation Tabs Bar -->
        <div id="tabs-navigation" class="flex overflow-x-auto space-x-2 pb-3 mb-6 border-b border-slate-200 no-print scrollbar-none">
            <button onclick="switchTab('wizard')" id="btn-tab-wizard" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold flex items-center space-x-2 transition whitespace-nowrap bg-kemenag-700 text-white shadow-sm">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                <span>1. Wizard Input & Generator</span>
            </button>
            <button onclick="switchTab('identitas')" id="btn-tab-identitas" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-medium flex items-center space-x-2 transition whitespace-nowrap bg-white text-slate-600 hover:bg-slate-100 border border-slate-200">
                <i class="fa-solid fa-id-card text-kemenag-600"></i>
                <span>Identitas Ujian</span>
            </button>
            <button onclick="switchTab('kisi')" id="btn-tab-kisi" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-medium flex items-center space-x-2 transition whitespace-nowrap bg-white text-slate-600 hover:bg-slate-100 border border-slate-200">
                <i class="fa-solid fa-table text-kemenag-600"></i>
                <span>Kisi-Kisi (Traceability)</span>
            </button>
            <button onclick="switchTab('soal')" id="btn-tab-soal" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-medium flex items-center space-x-2 transition whitespace-nowrap bg-white text-slate-600 hover:bg-slate-100 border border-slate-200">
                <i class="fa-solid fa-file-lines text-kemenag-600"></i>
                <span>Naskah Soal</span>
            </button>
            <button onclick="switchTab('kunci')" id="btn-tab-kunci" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-medium flex items-center space-x-2 transition whitespace-nowrap bg-white text-slate-600 hover:bg-slate-100 border border-slate-200">
                <i class="fa-solid fa-key text-kemenag-600"></i>
                <span>Kunci Jawaban</span>
            </button>
            <button onclick="switchTab('pembahasan')" id="btn-tab-pembahasan" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-medium flex items-center space-x-2 transition whitespace-nowrap bg-white text-slate-600 hover:bg-slate-100 border border-slate-200">
                <i class="fa-solid fa-lightbulb text-kemenag-600"></i>
                <span>Pembahasan</span>
            </button>
            <button onclick="switchTab('validasi')" id="btn-tab-validasi" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-medium flex items-center space-x-2 transition whitespace-nowrap bg-white text-slate-600 hover:bg-slate-100 border border-slate-200">
                <i class="fa-solid fa-shield-check text-kemenag-600"></i>
                <span>Validasi AI</span>
            </button>
            <button onclick="switchTab('dashboard')" id="btn-tab-dashboard" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-medium flex items-center space-x-2 transition whitespace-nowrap bg-white text-slate-600 hover:bg-slate-100 border border-slate-200">
                <i class="fa-solid fa-chart-pie text-kemenag-600"></i>
                <span>Dashboard & Statistik</span>
            </button>
        </div>

        <!-- ================= TAB 0: DASHBOARD / STATISTIK ================= -->
        <div id="tab-dashboard" class="tab-content">
            <div class="bg-gradient-to-br from-kemenag-900 to-kemenag-700 rounded-3xl p-6 sm:p-8 text-white shadow-xl mb-8 relative overflow-hidden">
                <div class="absolute right-0 top-0 w-96 h-96 bg-white/5 rounded-full blur-3xl pointer-events-none"></div>
                <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                    <div>
                        <span class="px-3 py-1 bg-amber-400 text-slate-900 font-bold rounded-full text-xs uppercase tracking-wider mb-3 inline-block">Sistem Asesmen Berbasis Kisi-Kisi (Sinkronisasi AI)</span>
                        <h2 class="text-2xl sm:text-3xl font-bold mb-2">KISI-SOAL AI SD/MI v2.6</h2>
                        <p class="text-kemenag-100 text-sm max-w-2xl">Generator kisi-kisi dan naskah soal otomatis berstandar nasional, kurikulum merdeka/k13, lengkap dengan traceabilitas indikator dan validasi ketat.</p>
                        <p class="text-xs text-amber-300 mt-2 font-medium">Development by witno</p>
                    </div>
                    <div class="flex flex-wrap gap-3">
                        <button onclick="switchTab('wizard')" class="px-5 py-3 bg-amber-400 hover:bg-amber-300 text-slate-900 font-bold rounded-xl shadow-lg transition flex items-center space-x-2">
                            <i class="fa-solid fa-play"></i>
                            <span>Mulai Generator Baru</span>
                        </button>
                        <button onclick="exportWord()" class="px-5 py-3 bg-white/10 hover:bg-white/20 text-white font-semibold rounded-xl backdrop-blur border border-white/20 transition flex items-center space-x-2">
                            <i class="fa-solid fa-file-word text-blue-300"></i>
                            <span>Export Word (.doc)</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Stats Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4">
                    <div class="w-12 h-12 rounded-xl bg-kemenag-50 text-kemenag-600 flex items-center justify-center text-xl font-bold">
                        <i class="fa-solid fa-table-list"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Total Kisi-Kisi</p>
                        <h4 id="stat-total-kisi" class="text-2xl font-bold text-slate-800">0</h4>
                    </div>
                </div>
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4">
                    <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl font-bold">
                        <i class="fa-solid fa-file-lines"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Total Soal</p>
                        <h4 id="stat-total-soal" class="text-2xl font-bold text-slate-800">0</h4>
                    </div>
                </div>
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4">
                    <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl font-bold">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Status Validasi</p>
                        <h4 id="stat-status-validasi" class="text-lg font-bold text-emerald-600">100% Sinkron</h4>
                    </div>
                </div>
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4">
                    <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl font-bold">
                        <i class="fa-solid fa-brain"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Opsi & Soal</p>
                        <h4 class="text-2xl font-bold text-kemenag-700">Akurat</h4>
                    </div>
                </div>
            </div>

            <!-- Level & Form Breakdown -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                    <h3 class="text-base font-bold text-slate-800 mb-4 flex items-center space-x-2">
                        <i class="fa-solid fa-layer-group text-kemenag-600"></i>
                        <span>Distribusi Level Kognitif</span>
                    </h3>
                    <div class="space-y-3">
                        <div>
                            <div class="flex justify-between text-xs font-semibold mb-1">
                                <span class="text-slate-600">L1 — Pengetahuan / Pemahaman</span>
                                <span id="count-l1" class="text-slate-800">0 Soal</span>
                            </div>
                            <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                                <div id="bar-l1" class="bg-blue-500 h-2 rounded-full" style="width: 0%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-xs font-semibold mb-1">
                                <span class="text-slate-600">L2 — Aplikasi (Penerapan)</span>
                                <span id="count-l2" class="text-slate-800">0 Soal</span>
                            </div>
                            <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                                <div id="bar-l2" class="bg-kemenag-500 h-2 rounded-full" style="width: 0%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-xs font-semibold mb-1">
                                <span class="text-slate-600">L3 — Penalaran (Analisis/Evaluasi)</span>
                                <span id="count-l3" class="text-slate-800">0 Soal</span>
                            </div>
                            <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                                <div id="bar-l3" class="bg-amber-500 h-2 rounded-full" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                    <h3 class="text-base font-bold text-slate-800 mb-4 flex items-center space-x-2">
                        <i class="fa-solid fa-shapes text-kemenag-600"></i>
                        <span>Bentuk Soal & Fitur Akses</span>
                    </h3>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="p-4 bg-slate-50 rounded-xl border border-slate-100">
                            <p class="text-xs text-slate-500">Pilihan Ganda</p>
                            <p id="count-pg" class="text-xl font-bold text-slate-800 mt-1">0</p>
                        </div>
                        <div class="p-4 bg-slate-50 rounded-xl border border-slate-100">
                            <p class="text-xs text-slate-500">Uraian / Essay</p>
                            <p id="count-uraian" class="text-xl font-bold text-slate-800 mt-1">0</p>
                        </div>
                        <div class="p-4 bg-slate-50 rounded-xl border border-slate-100">
                            <p class="text-xs text-slate-500">Jenjang Ujian</p>
                            <p id="summary-jenjang" class="text-sm font-bold text-kemenag-700 mt-1 truncate">SD Kelas 4</p>
                        </div>
                        <div class="p-4 bg-slate-50 rounded-xl border border-slate-100">
                            <p class="text-xs text-slate-500">Mata Pelajaran</p>
                            <p id="summary-mapel" class="text-sm font-bold text-kemenag-700 mt-1 truncate">Matematika</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= TAB 1: WIZARD INPUT & GENERATOR ================= -->
        <div id="tab-wizard" class="tab-content active">
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8 mb-8">
                <div class="flex items-center space-x-3 mb-6 pb-4 border-b border-slate-100">
                    <div class="w-10 h-10 rounded-xl bg-kemenag-100 text-kemenag-700 flex items-center justify-center font-bold">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold text-slate-800">Wizard Generator Asesmen SD/MI</h2>
                        <p class="text-xs text-slate-500">Tentukan parameter pembelajaran. AI akan menyusun kisi-kisi dan soal dengan opsi jawaban yang 100% sinkron.</p>
                    </div>
                </div>

                <form id="wizard-form" onsubmit="event.preventDefault(); startGeneratorAI();" class="space-y-6">
                    <!-- Jenjang & Kelas -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1.5 uppercase tracking-wide">Pilih Jenjang & Kelas</label>
                            <select id="input-jenjang" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-kemenag-500 text-sm bg-slate-50">
                                <optgroup label="Sekolah Dasar (SD)">
                                    <option value="SD Kelas 1">SD Kelas 1</option>
                                    <option value="SD Kelas 2">SD Kelas 2</option>
                                    <option value="SD Kelas 3">SD Kelas 3</option>
                                    <option value="SD Kelas 4" selected>SD Kelas 4</option>
                                    <option value="SD Kelas 5">SD Kelas 5</option>
                                    <option value="SD Kelas 6">SD Kelas 6</option>
                                </optgroup>
                                <optgroup label="Madrasah Ibtidaiyah (MI)">
                                    <option value="MI Kelas 1">MI Kelas 1</option>
                                    <option value="MI Kelas 2">MI Kelas 2</option>
                                    <option value="MI Kelas 3">MI Kelas 3</option>
                                    <option value="MI Kelas 4">MI Kelas 4</option>
                                    <option value="MI Kelas 5">MI Kelas 5</option>
                                    <option value="MI Kelas 6">MI Kelas 6</option>
                                </optgroup>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1.5 uppercase tracking-wide">Mata Pelajaran (Sesuai KMA 1503 & Mulok)</label>
                            <select id="input-mapel" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-kemenag-500 text-sm bg-slate-50" onchange="handleMapelChange()">
                                <optgroup label="Mata Pelajaran Umum (Kurikulum Merdeka / K13)">
                                    <option value="Matematika">Matematika</option>
                                    <option value="Bahasa Indonesia">Bahasa Indonesia</option>
                                    <option value="Ilmu Pengetahuan Alam dan Sosial (IPAS)">IPAS (Ilmu Pengetahuan Alam dan Sosial)</option>
                                    <option value="Pendidikan Pancasila / PPKn">Pendidikan Pancasila / PPKn</option>
                                    <option value="Seni Rupa / Seni Musik / Seni Teater / Seni Tari">Seni Budaya & Keterampilan</option>
                                    <option value="Pendidikan Jasmani, Olahraga, dan Kesehatan (PJOK)">PJOK</option>
                                    <option value="Bahasa Inggris">Bahasa Inggris (Pilihan)</option>
                                </optgroup>
                                <optgroup label="Mata Pelajaran Kekhasan Madrasah (KMA 1503)">
                                    <option value="Al-Qur'an Hadis (KMA 1503)">Al-Qur'an Hadis (KMA 1503)</option>
                                    <option value="Akidah Akhlak (KMA 1503)">Akidah Akhlak (KMA 1503)</option>
                                    <option value="Fikih (KMA 1503)">Fikih (KMA 1503)</option>
                                    <option value="Sejarah Kebudayaan Islam / SKI (KMA 1503)">Sejarah Kebudayaan Islam / SKI (KMA 1503)</option>
                                    <option value="Bahasa Arab (KMA 1503)">Bahasa Arab (KMA 1503)</option>
                                    <option value="Pendidikan Agama Islam (PAI)">Pendidikan Agama Islam (Umum)</option>
                                </optgroup>
                                <optgroup label="Muatan Lokal (Mulok)">
                                    <option value="Mulok Bahasa Daerah / Bahasa Daerah (Jawa/Sunda/dll)">Mulok Bahasa Daerah (Bahasa Ibu)</option>
                                    <option value="Mulok Keagamaan / Baca Tulis Al-Qur'an (BTA)">Mulok Baca Tulis Al-Qur'an (BTA)</option>
                                    <option value="Mulok Pendidikan Lingkungan Hidup (PLH)">Mulok Pendidikan Lingkungan Hidup (PLH)</option>
                                    <option value="Mulok Keterampilan / Kewirausahaan Lokal">Mulok Keterampilan / Kewirausahaan</option>
                                </optgroup>
                            </select>
                        </div>
                    </div>

                    <!-- Semester & Jumlah Soal -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1.5 uppercase tracking-wide">Semester</label>
                            <select id="input-semester" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-kemenag-500 text-sm bg-slate-50">
                                <option value="Semester 1 (Ganjil)">Semester 1 (Ganjil)</option>
                                <option value="Semester 2 (Genap)">Semester 2 (Genap)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1.5 uppercase tracking-wide">Jumlah Soal</label>
                            <select id="input-jumlah" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-kemenag-500 text-sm bg-slate-50">
                                <option value="5">5 Soal (Simulasi Cepat)</option>
                                <option value="10" selected>10 Soal</option>
                                <option value="15">15 Soal</option>
                                <option value="20">20 Soal</option>
                                <option value="25">25 Soal</option>
                                <option value="30">30 Soal</option>
                            </select>
                        </div>
                    </div>

                    <!-- CP, TP, & Materi -->
                    <div class="space-y-4 pt-2">
                        <div>
                            <div class="flex items-center justify-between mb-1.5">
                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wide">Capaian Pembelajaran (CP)</label>
                                <button type="button" onclick="loadDefaultCP()" class="text-xs text-kemenag-600 hover:text-kemenag-800 font-medium">
                                    <i class="fa-solid fa-wand-magic mr-1"></i> Isi Otomatis Sesuai Mapel
                                </button>
                            </div>
                            <textarea id="input-cp" rows="2" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-kemenag-500 text-sm bg-slate-50" placeholder="Ketik atau pilih capaian pembelajaran...">Peserta didik dapat memahami konsep pecahan sederhana, membandingkan, serta melakukan operasi hitung sederhana dalam kehidupan sehari-hari.</textarea>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1.5 uppercase tracking-wide">Tujuan Pembelajaran (TP)</label>
                            <textarea id="input-tp" rows="2" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-kemenag-500 text-sm bg-slate-50" placeholder="Ketik tujuan pembelajaran...">1. Peserta didik mampu mengidentifikasi pecahan senilai. 2. Peserta didik mampu membandingkan nilai dua pecahan sederhana.</textarea>
